<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNGmod widget: the static preview in the launcher's widget list (Android 12+). Made-up numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mod_widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mod_widget_preview_value"
        android:textColor="#FF4E8A55"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:text="@string/mod_widget_preview_arrow"
        android:textColor="#FF4E8A55"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_widget_preview_delta"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_widget_just_now"
            android:textColor="#F2FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/mod_widget_preview_dots" />
</LinearLayout>
