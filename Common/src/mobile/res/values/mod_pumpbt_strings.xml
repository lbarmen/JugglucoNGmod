    <string name="mod_pumpbt_stop_by_switch">To stop the link, turn Permanent operation off.</string>
    <!-- %1$s - duration (mod_pumpbt_duration) -->
    <string name="mod_pumpbt_pair_wait">The phone is waiting for the pump: %1$s (usually up to a minute)</string>
    <!-- %1$s - "Mobile NNNNNN" -->
    <string name="mod_pumpbt_pairing_failed">Pairing did not finish. On the pump, choose Pair New Device again and pick %1$s. On the phone, confirm the pairing request (it may come as a notification). No request? Turn Bluetooth off and on; if that does not help, restart the phone. The phone keeps waiting by itself: connecting usually takes about half a minute, so do not stop it early.</string>

    <string name="mod_pumpbt_section_permanent">Permanent operation</string>
    <string name="mod_pumpbt_permanent">Permanent operation</string>
    <string name="mod_pumpbt_permanent_off">Off: the pump is read only with the buttons below, nothing goes to the journal.</string>
    <string name="mod_pumpbt_permanent_on">On: the phone stays linked to the pump in the background and writes its boluses, carbs and basal to the journal.</string>
    <string name="mod_pumpbt_permanent_needs">To turn it on, load the key and turn Bluetooth on.</string>
    <string name="mod_pumpbt_permanent_ask_title">Turn on permanent operation?</string>
    <string name="mod_pumpbt_permanent_ask_text">The app will stay linked to the pump and write its boluses, carbs and basal to the journal. The CareLink cloud is not read while this is on. MiniMed Mobile must not be connected to the pump at the same time. The app only reads the pump and never changes anything on it. This is a trial, not a medical device: check doses on the pump.</string>
    <string name="mod_pumpbt_permanent_ask_confirm">Turn on</string>
    <string name="mod_pumpbt_sensor_bluetooth_off">Bluetooth for the sensor is off in this app. Then Android may close the app in the background and pump data will stop coming.</string>
    <string name="mod_pumpbt_memory_load_failed">The saved pump history could not be read. It is being collected again.</string>
    <string name="mod_pumpbt_bond_lost_title">The phone has forgotten the pump</string>
    <!-- %1$s - "Mobile NNNNNN" -->
    <string name="mod_pumpbt_bond_lost_text">The pump is marked as paired, but it is no longer in the phone\'s Bluetooth list, so no data can come. Press Pair again, then on the pump choose Pair New Device and pick %1$s, and confirm the request on the phone (it may come as a notification). No request? Turn Bluetooth off and on; if that does not help, restart the phone.</string>
    <string name="mod_pumpbt_pair_again">Pair again</string>

