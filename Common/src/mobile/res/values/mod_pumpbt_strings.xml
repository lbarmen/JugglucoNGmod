    <string name="mod_pumpbt_variant_hint">If the pump does not list Mobile … or pairing fails twice, press Stop and try B.</string>
    <string name="mod_pumpbt_stop_minimed_hint">Before pairing, stop MiniMed Mobile: Settings → Apps → MiniMed Mobile → Force stop.</string>
    <string name="mod_pumpbt_start_pairing">Start pairing</string>
    <string name="mod_pumpbt_start_pairing_hint">Keep this screen open and the phone unlocked. When the phone asks to pair with the pump, confirm at once.</string>
