    <string name="mod_pumpbt_backfill_meals_not_written">Carbs that will not be written (carb writing is off, or their bolus is not written): %1$d</string>
    <string name="mod_pumpbt_backfill_hint">New pump data is written in any case. This choice is only about the old records.</string>
    <string name="mod_pumpbt_backfill_write">Write</string>
    <string name="mod_pumpbt_backfill_decline">Do not write old ones</string>
