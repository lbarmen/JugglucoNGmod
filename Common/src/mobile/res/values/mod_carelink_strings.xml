    <string name="mod_carelink_section_pump">Pump · data %1$s</string>
    <string name="mod_carelink_iob">Pump active insulin</string>
    <string name="mod_carelink_reservoir">Reservoir</string>
    <string name="mod_carelink_battery">Pump battery</string>
    <string name="mod_carelink_percent">%1$d %%</string>
    <string name="mod_carelink_section_settings">Settings</string>
    <string name="mod_carelink_minutes">%1$d min</string>
    <string name="mod_carelink_warn_after">Warn after</string>
    <string name="mod_carelink_warn_after_hint">How many minutes without pump data, or with records not saved to the journal, before a notification.</string>
    <string name="mod_carelink_insulin">Insulin in the pump</string>
    <string name="mod_carelink_insulin_none">No insulin types available</string>
    <string name="mod_carelink_insulin_hint">Pump boluses go to the journal with this insulin type: the app works out its own active insulin by it.</string>
    <string name="mod_carelink_write_carbs">Record carbs from the pump calculator</string>
    <string name="mod_carelink_write_carbs_hint">Carbs entered in the pump calculator go to the journal with their bolus.</string>
    <string name="mod_carelink_nightscout">Send pump records to Nightscout</string>
    <string name="mod_carelink_nightscout_hint">New pump records go to Nightscout, and to LibreView if sending to it is on. Older records are not sent. The Nightscout setting \"Send insulin and carbs\" must be on too.</string>
    <string name="mod_carelink_section_phone">Phone</string>
    <string name="mod_carelink_battery_exempt">Exclude from battery saving</string>
    <string name="mod_carelink_battery_exempt_hint">Otherwise Android may delay the link to the pump and its warnings.</string>
    <string name="mod_carelink_notifications">Allow notifications</string>
    <!-- the three notification titles as they are; %1$d - the warning threshold -->
    <string name="mod_carelink_notifications_hint">So that the warnings can reach you: \"No pump data for over %1$d min\", \"Pump records are not saved\", \"The phone forgot the pump\" and others.</string>
    <string name="mod_carelink_channel_off">Pump notifications are off</string>
    <string name="mod_carelink_channel_off_hint">The pump channel is turned off in the phone settings, so no warnings will come. Tap to turn it on.</string>
    <string name="mod_carelink_sound">Notification sound and vibration</string>
    <string name="mod_carelink_sound_hint">The system settings of the pump notifications.</string>
