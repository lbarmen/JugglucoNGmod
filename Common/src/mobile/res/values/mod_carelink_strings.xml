<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNGmod, CareLink: strings of our own windows (English; Russian in values-ru). Not an overlay of upstream's
     strings: every name starts with mod_carelink_. One set of words in the window and the notifications: "update"
     (never "poll"), "sign-in" (never "session"). -->
<resources>
    <string name="mod_carelink_channel_name">Pump</string>
    <string name="mod_carelink_channel_description">Warnings: pump data is not coming in or not saved</string>
    <!-- %1$d - the warning threshold, not the age at the moment of showing (the notification is not updated) -->
    <string name="mod_carelink_no_data_title">No pump data for over %1$d min</string>
    <string name="mod_carelink_no_data_text">No new data has come from the pump. Check that the pump is near the phone and Bluetooth is on, and open the pump window. The active insulin in the app may be old; check the pump.</string>
    <string name="mod_carelink_write_fail_title">Pump records are not saved</string>
    <string name="mod_carelink_write_fail_text">For %1$d min pump records have not reached the app\'s journal. Open the pump window and tap Read again under Diagnostics; if it repeats, restart the app.</string>
    <string name="mod_carelink_journal_bolus">Pump bolus</string>
    <string name="mod_carelink_journal_carbs">Pump calculator</string>
    <string name="mod_carelink_journal_basal">Pump basal</string>
    <string name="mod_carelink_journal_stop">Pump stopped</string>
    <string name="mod_carelink_note_running">in progress, %1$s U programmed</string>
    <string name="mod_carelink_note_interrupted">stopped early: %1$s of %2$s U delivered</string>
    <string name="mod_carelink_note_extended">square or dual wave bolus (%1$s)</string>
    <!-- the chart chip of a note shows its first 10 characters (upstream's journalMarkerDetail): "Stop HH:MM" fits -->
    <string name="mod_carelink_note_stop_open">Stop %1$s–…</string>
    <string name="mod_carelink_note_stop">Stop %1$s–%2$s</string>
    <!-- the CareLink window (4e) -->
    <string name="mod_carelink_title">Pump</string>
    <string name="mod_carelink_entry_subtitle">MiniMed pump over Bluetooth: pairing, data, settings</string>
    <string name="mod_carelink_shortcut_short">Pump</string>
    <string name="mod_carelink_shortcut_long">Pump window</string>
    <string name="mod_carelink_data_none">No pump data yet</string>
    <string name="mod_carelink_age_now">just now</string>
    <string name="mod_carelink_age_min">%1$d min ago</string>
    <string name="mod_carelink_age_hours">%1$d h %2$d min ago</string>
    <string name="mod_carelink_age_day">over a day ago</string>
    <string name="mod_carelink_close">Close</string>
