<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNGmod, phone and watch (build type mod): upstream adaptive icon (Common/src/main/res/mipmap-anydpi-v26/), but the foreground
     is upstream's picture with our orange "M" badge on top (drawable/mod_launcher_foreground.xml), so the launcher
     tells JugglucoNGmod apart from the official JugglucoNG. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/mod_launcher_foreground"/>
</adaptive-icon>
